# ---- Root env template (never commit real secrets) ----
# Postgres (docker-compose)
POSTGRES_USER=uniforge
POSTGRES_PASSWORD=uniforge
POSTGRES_DB=uniforge
POSTGRES_PORT=5432

# Backend (also see backend/.env.example)
DATABASE_URL=postgresql+psycopg2://uniforge:uniforge@localhost:5432/uniforge
CORS_ORIGINS=http://localhost:3000

# Frontend (also see frontend/.env.example)
NEXT_PUBLIC_API_URL=http://localhost:8000
